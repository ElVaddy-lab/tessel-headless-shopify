# Copy to .env.local and fill in. Never commit real values.

# Store domain, e.g. your-store.myshopify.com
SHOPIFY_STORE_DOMAIN=

# Storefront API token. Private token is preferred (used only on the server).
# A public token also works if that's what the store provides.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=

# Storefront API version (quarterly, YYYY-MM)
SHOPIFY_STOREFRONT_API_VERSION=2026-10

# Admin API for the store setup scripts (Dev Dashboard app, client credentials grant).
# Never used by the storefront itself.
SHOPIFY_ADMIN_CLIENT_ID=
SHOPIFY_ADMIN_CLIENT_SECRET=

# Webhook signing secret for HMAC verification (stage 15)
SHOPIFY_WEBHOOK_SECRET=
